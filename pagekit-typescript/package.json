{
  "name": "@arovi/pagekit-core",
  "version": "0.1.3",
  "description": "TypeScript client for the Pagekit content API.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arovi-labs/pagekit.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/arovi-labs/pagekit#readme",
  "bugs": {
    "url": "https://github.com/arovi-labs/pagekit/issues"
  }
}
