{
  "name": "@arovi/pagekit-mcp",
  "version": "1.0.3",
  "description": "MCP server for Pagekit blog CMS \u2014 lets AI agents manage posts, tags, categories, authors, and media.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pagekit-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "test:inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pagekit",
    "mcp",
    "model-context-protocol",
    "ai",
    "blog",
    "cms",
    "headless"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arovi-labs/pagekit.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/arovi-labs/pagekit#readme",
  "bugs": {
    "url": "https://github.com/arovi-labs/pagekit/issues"
  },
  "license": "MIT"
}
